    <string name="permission_denied_title">Permiso de micrófono bloqueado</string>
    <string name="permission_denied_body">Aura non pode gravar sen acceso ao micrófono, e xa non pode solicitalo directamente. Activa o permiso desde os axustes do sistema para esta app.</string>
    <string name="permission_denied_open_settings">Abrir axustes</string>

