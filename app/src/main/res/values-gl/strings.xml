    <!-- Permission rationale -->
    <string name="permission_rationale_title">Precísase acceso ao micrófono</string>
    <string name="permission_rationale_body">Aura grava audio nos ficheiros que crea. Precisa acceso ao micrófono para gravar, acceso ás notificacións para que vexas cando hai unha gravación activa, e acceso ao estado do teléfono para pausarse automaticamente durante unha chamada.</string>
    <string name="permission_rationale_continue">Continuar</string>
    <string name="permission_rationale_not_now">Agora non</string>

